{
  "name": "@tanstack/ai-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3010",
    "build": "vite build",
    "test:types": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "record": "LLMOCK_RECORD=true pnpm dev",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@copilotkit/aimock": "^1.34.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/sdk": "0.13.20",
    "@opentelemetry/api": "^1.9.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "workspace:*",
    "@tanstack/ai-anthropic": "workspace:*",
    "@tanstack/ai-bedrock": "workspace:*",
    "@tanstack/ai-byteplus": "workspace:*",
    "@tanstack/ai-claude-code": "workspace:*",
    "@tanstack/ai-client": "workspace:*",
    "@tanstack/ai-cloudflare": "workspace:*",
    "@tanstack/ai-compaction": "workspace:*",
    "@tanstack/ai-elevenlabs": "workspace:*",
    "@tanstack/ai-fal": "workspace:*",
    "@tanstack/ai-gemini": "workspace:*",
    "@tanstack/ai-grok": "workspace:*",
    "@tanstack/ai-groq": "workspace:*",
    "@tanstack/ai-llmgateway": "workspace:*",
    "@tanstack/ai-lovable": "workspace:*",
    "@tanstack/ai-mcp": "workspace:*",
    "@tanstack/ai-memory": "workspace:*",
    "@tanstack/ai-mistral": "workspace:*",
    "@tanstack/ai-ollama": "workspace:*",
    "@tanstack/ai-openai": "workspace:*",
    "@tanstack/ai-openrouter": "workspace:*",
    "@tanstack/ai-persistence": "workspace:*",
    "@tanstack/ai-react": "workspace:*",
    "@tanstack/ai-reactor": "workspace:*",
    "@tanstack/ai-sandbox": "workspace:*",
    "@tanstack/ai-sandbox-local-process": "workspace:*",
    "@tanstack/ai-skills": "workspace:*",
    "@tanstack/ai-vercel-gateway": "workspace:*",
    "@tanstack/ai-vertex": "workspace:*",
    "@tanstack/ai-worldlabs": "workspace:*",
    "@tanstack/devtools-event-bus": "^0.4.1",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.0",
    "@tanstack/react-ai-devtools": "workspace:*",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "arktype": "^2.1.28",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.18",
    "ws": "^8.18.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@smithy/eventstream-codec": "^4.3.7",
    "@smithy/node-http-handler": "^4.8.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "miniflare": "^4.20260609.0",
    "typescript": "5.9.3",
    "vite": "^8.2.1"
  },
  "nx": {
    "targets": {
      "test:e2e:ci": {
        "executor": "nx:noop",
        "cache": true,
        "outputs": [],
        "dependsOn": [
          "test:e2e--shard-1-of-4",
          "test:e2e--shard-2-of-4",
          "test:e2e--shard-3-of-4",
          "test:e2e--shard-4-of-4"
        ]
      },
      "test:e2e--shard-1-of-4": {
        "executor": "nx:run-commands",
        "cache": true,
        "parallelism": false,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "CI"
          }
        ],
        "outputs": [
          "{projectRoot}/test-results/shard-1",
          "{projectRoot}/playwright-report/shard-1"
        ],
        "options": {
          "command": "pnpm exec playwright test --shard=1/4 --output=test-results/shard-1",
          "cwd": "testing/e2e",
          "env": {
            "PLAYWRIGHT_HTML_OUTPUT_DIR": "playwright-report/shard-1"
          }
        }
      },
      "test:e2e--shard-2-of-4": {
        "executor": "nx:run-commands",
        "cache": true,
        "parallelism": false,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "CI"
          }
        ],
        "outputs": [
          "{projectRoot}/test-results/shard-2",
          "{projectRoot}/playwright-report/shard-2"
        ],
        "options": {
          "command": "pnpm exec playwright test --shard=2/4 --output=test-results/shard-2",
          "cwd": "testing/e2e",
          "env": {
            "PLAYWRIGHT_HTML_OUTPUT_DIR": "playwright-report/shard-2"
          }
        }
      },
      "test:e2e--shard-3-of-4": {
        "executor": "nx:run-commands",
        "cache": true,
        "parallelism": false,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "CI"
          }
        ],
        "outputs": [
          "{projectRoot}/test-results/shard-3",
          "{projectRoot}/playwright-report/shard-3"
        ],
        "options": {
          "command": "pnpm exec playwright test --shard=3/4 --output=test-results/shard-3",
          "cwd": "testing/e2e",
          "env": {
            "PLAYWRIGHT_HTML_OUTPUT_DIR": "playwright-report/shard-3"
          }
        }
      },
      "test:e2e--shard-4-of-4": {
        "executor": "nx:run-commands",
        "cache": true,
        "parallelism": false,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "CI"
          }
        ],
        "outputs": [
          "{projectRoot}/test-results/shard-4",
          "{projectRoot}/playwright-report/shard-4"
        ],
        "options": {
          "command": "pnpm exec playwright test --shard=4/4 --output=test-results/shard-4",
          "cwd": "testing/e2e",
          "env": {
            "PLAYWRIGHT_HTML_OUTPUT_DIR": "playwright-report/shard-4"
          }
        }
      }
    }
  }
}
