{
  "name": "@tanstack/ai-cartesia",
  "version": "0.0.0",
  "description": "Cartesia speech and transcription adapters for TanStack AI",
  "author": "Tanner Linsley",
  "license": "MIT",
  "homepage": "https://tanstack.com/ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/ai.git",
    "directory": "packages/ai-cartesia"
  },
  "type": "module",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist", "src"],
  "scripts": {
    "build": "vite build",
    "clean": "premove ./build ./dist",
    "test:build": "publint --strict",
    "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:lib": "vitest run",
    "test:types": "tsc",
    "test:oxlint": "oxlint src --type-aware"
  },
  "keywords": ["ai", "tanstack", "cartesia", "text-to-speech", "transcription"],
  "devDependencies": {
    "@tanstack/ai": "workspace:*",
    "@vitest/coverage-v8": "4.1.10",
    "vite": "^8.2.1"
  },
  "peerDependencies": {
    "@tanstack/ai": "workspace:^"
  },
  "dependencies": {
    "@tanstack/ai-utils": "workspace:^"
  }
}
