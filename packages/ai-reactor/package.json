{
  "name": "@tanstack/ai-reactor",
  "version": "0.1.0",
  "description": "Reactor adapter for TanStack AI live world and video generation (Orbis, Happy Oyster, LingBot, Helios, FastH3).",
  "author": "Tanner Linsley",
  "license": "MIT",
  "homepage": "https://tanstack.com/ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/ai.git",
    "directory": "packages/ai-reactor"
  },
  "bugs": {
    "url": "https://github.com/TanStack/ai/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "type": "module",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./byok": {
      "types": "./dist/esm/byok.d.ts",
      "import": "./dist/esm/byok.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "premove ./build ./dist",
    "lint:fix": "oxlint src --type-aware --fix",
    "test:build": "publint --strict",
    "test:oxlint": "oxlint src --type-aware",
    "test:lib": "vitest run",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "typescript",
    "tanstack",
    "reactor",
    "adapter",
    "world-generation",
    "video-generation",
    "world-models",
    "orbis",
    "realtime-video"
  ],
  "dependencies": {
    "@tanstack/ai-utils": "workspace:^"
  },
  "devDependencies": {
    "@tanstack/ai": "workspace:*",
    "@vitest/coverage-v8": "4.1.10",
    "vite": "^8.2.1"
  },
  "peerDependencies": {
    "@tanstack/ai": "workspace:^"
  }
}
