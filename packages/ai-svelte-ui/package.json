{
  "name": "@tanstack/ai-svelte-ui",
  "version": "0.1.0",
  "description": "Deprecated. Import chat UI from @tanstack/ai-svelte/ui instead.",
  "author": "Tanner Linsley",
  "license": "MIT",
  "homepage": "https://tanstack.com/ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/ai.git",
    "directory": "packages/ai-svelte-ui"
  },
  "bugs": {
    "url": "https://github.com/TanStack/ai/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "deprecated": "Use @tanstack/ai-svelte/ui instead. See https://tanstack.com/ai/latest/docs/migration/create-ui",
  "type": "module",
  "svelte": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "premove ./dist",
    "test:oxlint": "oxlint src --type-aware",
    "test:lib": "vitest --passWithNoTests",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "svelte-check",
    "test:build": "publint --strict",
    "build": "svelte-package -i src -o dist"
  },
  "keywords": [
    "ai",
    "tanstack",
    "svelte",
    "chat",
    "ui",
    "deprecated"
  ],
  "dependencies": {
    "@tanstack/ai-svelte": "workspace:^"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.10",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tanstack/ai-svelte": "workspace:*",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "svelte": "^5.56.9",
    "svelte-check": "^4.2.0",
    "typescript": "5.9.3",
    "vite": "^8.2.1"
  }
}
