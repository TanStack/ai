{
  "name": "@tanstack/ai-dashboard",
  "version": "0.0.0",
  "description": "A self-hosted dashboard for TanStack AI harnesses: watch sessions, approve tools, and send prompts from a browser or a phone",
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/ai.git",
    "directory": "packages/ai-dashboard"
  },
  "type": "module",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "bin": {
    "tanstack-ai-dashboard": "./bin/dashboard.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./connect": {
      "types": "./dist/esm/connect.d.ts",
      "import": "./dist/esm/connect.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "premove ./build ./dist",
    "lint:fix": "oxlint src --type-aware --fix",
    "test:build": "publint --strict",
    "test:oxlint": "oxlint src --type-aware",
    "test:coverage": "vitest run --passWithNoTests --coverage --coverage.include='src/**' --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:lib": "vitest --passWithNoTests",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc"
  },
  "nx": {
    "targets": {
      "test:lib": {
        "dependsOn": [
          "build",
          "^build"
        ]
      },
      "test:coverage": {
        "dependsOn": [
          "build",
          "^build"
        ]
      },
      "test:types": {
        "dependsOn": [
          "build",
          "^build"
        ]
      }
    }
  },
  "keywords": [
    "ai",
    "tanstack",
    "harness",
    "dashboard",
    "relay",
    "pwa"
  ],
  "peerDependencies": {
    "@tanstack/ai": "workspace:^",
    "@tanstack/ai-harness": "workspace:^"
  },
  "devDependencies": {
    "@tanstack/ai": "workspace:*",
    "@tanstack/ai-harness": "workspace:*",
    "@tanstack/ai-persistence": "workspace:*",
    "@vitest/coverage-v8": "4.1.10"
  }
}
