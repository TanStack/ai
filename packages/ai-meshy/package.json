{
  "name": "@tanstack/ai-meshy",
  "version": "0.0.0",
  "description": "Meshy adapter for TanStack AI 3D model and motion generation.",
  "author": "Tanner Linsley",
  "license": "MIT",
  "homepage": "https://tanstack.com/ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/ai.git",
    "directory": "packages/ai-meshy"
  },
  "bugs": {
    "url": "https://github.com/TanStack/ai/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "type": "module",
  "sideEffects": false,
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./byok": {
      "types": "./dist/esm/byok.d.ts",
      "import": "./dist/esm/byok.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "premove ./build ./dist",
    "lint:fix": "oxlint src --type-aware --fix",
    "test:build": "publint --strict",
    "test:oxlint": "oxlint src --type-aware",
    "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:lib": "vitest run",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "typescript",
    "tanstack",
    "meshy",
    "adapter",
    "3d",
    "3d-generation",
    "text-to-3d",
    "image-to-3d",
    "motion",
    "motion-generation",
    "rigging",
    "animation"
  ],
  "dependencies": {
    "@tanstack/ai-utils": "workspace:^"
  },
  "devDependencies": {
    "@tanstack/ai": "workspace:*",
    "@vitest/coverage-v8": "4.1.12",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@tanstack/ai": "workspace:^"
  }
}
