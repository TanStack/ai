{
  "name": "@tanstack/ai-harness",
  "version": "0.0.0",
  "description": "Build agent harnesses on TanStack AI: long-lived sessions, typed agents, and plugins",
  "keywords": [
    "agent",
    "ai",
    "harness",
    "plugins",
    "session",
    "tanstack"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/ai.git",
    "directory": "packages/ai-harness"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./client": {
      "types": "./dist/esm/client.d.ts",
      "import": "./dist/esm/client.js"
    },
    "./view": {
      "types": "./dist/esm/view/index.d.ts",
      "import": "./dist/esm/view/index.js"
    },
    "./plugins": {
      "types": "./dist/esm/first-party/index.d.ts",
      "import": "./dist/esm/first-party/index.js"
    },
    "./plugins/coding": {
      "types": "./dist/esm/first-party/coding/index.d.ts",
      "import": "./dist/esm/first-party/coding/index.js"
    },
    "./build": {
      "types": "./dist/esm/build.d.ts",
      "import": "./dist/esm/build.js"
    },
    "./worker": {
      "types": "./dist/esm/worker.d.ts",
      "import": "./dist/esm/worker.js"
    },
    "./ag-ui": {
      "types": "./dist/esm/ag-ui.d.ts",
      "import": "./dist/esm/ag-ui.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "clean": "premove ./build ./dist",
    "lint:fix": "oxlint src --type-aware --fix",
    "test:build": "publint --strict",
    "test:oxlint": "oxlint src --type-aware",
    "test:coverage": "vitest run --passWithNoTests --coverage --coverage.include='src/**' --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:lib": "vitest --passWithNoTests",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.0",
    "@ag-ui/encoder": "1.0.0",
    "@tanstack/store": "^0.11.1"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.0",
    "@tanstack/ai": "workspace:*",
    "@tanstack/ai-persistence": "workspace:*",
    "@vitest/coverage-v8": "4.1.10",
    "@vscode/ripgrep": "^1.18.0",
    "turndown": "^7.2.4",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@tanstack/ai": "workspace:^",
    "@tanstack/ai-persistence": "workspace:^",
    "@vscode/ripgrep": "^1.15.0",
    "turndown": "^7.2.0"
  },
  "peerDependenciesMeta": {
    "@vscode/ripgrep": {
      "optional": true
    },
    "turndown": {
      "optional": true
    }
  },
  "nx": {
    "targets": {
      "test:lib": {
        "dependsOn": [
          "build",
          "^build"
        ]
      },
      "test:coverage": {
        "dependsOn": [
          "build",
          "^build"
        ]
      },
      "test:types": {
        "dependsOn": [
          "build",
          "^build"
        ]
      }
    }
  }
}
