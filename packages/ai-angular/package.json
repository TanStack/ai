{
  "name": "@tanstack/ai-angular",
  "version": "1.1.0",
  "description": "Angular signals integration for TanStack AI streaming chat, structured outputs, and media generation.",
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/ai.git",
    "directory": "packages/ai-angular"
  },
  "homepage": "https://tanstack.com/ai",
  "keywords": [
    "ai",
    "ai-sdk",
    "typescript",
    "tanstack",
    "angular",
    "signals",
    "chat",
    "streaming",
    "tool-calling",
    "structured-outputs",
    "media-generation"
  ],
  "type": "module",
  "module": "dist/fesm2022/tanstack-ai-angular.mjs",
  "types": "./dist/types/tanstack-ai-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/tanstack-ai-angular.d.ts",
      "default": "./dist/fesm2022/tanstack-ai-angular.mjs"
    },
    "./package.json": {
      "default": "./package.json"
    },
    "./ui": {
      "types": "./dist/types/tanstack-ai-angular-ui.d.ts",
      "default": "./dist/fesm2022/tanstack-ai-angular-ui.mjs"
    },
    "./byok": {
      "types": "./dist/types/tanstack-ai-angular-byok.d.ts",
      "default": "./dist/fesm2022/tanstack-ai-angular-byok.mjs"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src",
    "ui"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "test:oxlint": "oxlint src ui/src --type-aware",
    "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.include='ui/src/**' --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:lib": "vitest run",
    "test:lib:dev": "vitest",
    "test:types": "tsc",
    "test:build": "publint --strict",
    "build": "ng-packagr -p ng-package.json -c tsconfig.build.json && premove ./dist/package.json"
  },
  "dependencies": {
    "@tanstack/ai-client": "workspace:^",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": ">=22.0.0 <23",
    "@angular/core": ">=22.0.0 <23",
    "@tanstack/ai": "workspace:^"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.6",
    "@angular/build": "22.2.4",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@tanstack/ai": "workspace:*",
    "@types/node": "^24.10.1",
    "jsdom": "^27.4.0",
    "ng-packagr": "^22.2.1",
    "typescript": "6.0.2",
    "vitest": "^4.1.12",
    "zod": "^4.2.0",
    "zone.js": "^0.15.0"
  }
}
