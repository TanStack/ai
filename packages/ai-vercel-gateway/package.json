{
  "name": "@tanstack/ai-vercel-gateway",
  "version": "0.2.5",
  "description": "Vercel AI Gateway adapter for TanStack AI chat, embeddings, and image generation.",
  "author": "Tanner Linsley",
  "license": "MIT",
  "homepage": "https://tanstack.com/ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/ai.git",
    "directory": "packages/ai-vercel-gateway"
  },
  "bugs": {
    "url": "https://github.com/TanStack/ai/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "type": "module",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./byok": {
      "types": "./dist/esm/byok.d.ts",
      "import": "./dist/esm/byok.js"
    },
    "./tools": {
      "types": "./dist/esm/tools/index.d.ts",
      "import": "./dist/esm/tools/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "premove ./build ./dist",
    "lint:fix": "oxlint src --type-aware --fix",
    "test:build": "publint --strict",
    "test:oxlint": "oxlint src --type-aware",
    "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:lib": "vitest run",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "typescript",
    "tanstack",
    "vercel",
    "ai-gateway",
    "adapter",
    "llm",
    "chat",
    "embeddings",
    "image-generation"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "vite": "^8.2.1"
  },
  "peerDependencies": {
    "@tanstack/ai": "workspace:^"
  },
  "dependencies": {
    "@tanstack/ai-utils": "workspace:^",
    "@tanstack/openai-base": "workspace:^",
    "openai": "^6.41.0"
  }
}
