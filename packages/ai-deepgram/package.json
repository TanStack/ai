{
  "name": "@tanstack/ai-deepgram",
  "version": "0.0.0",
  "description": "Deepgram adapter for TanStack AI live speech-to-text (Nova-3 and Flux).",
  "author": "Tanner Linsley",
  "license": "MIT",
  "homepage": "https://tanstack.com/ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/ai.git",
    "directory": "packages/ai-deepgram"
  },
  "bugs": {
    "url": "https://github.com/TanStack/ai/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "type": "module",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "premove ./build ./dist",
    "lint:fix": "oxlint src --type-aware --fix",
    "test:build": "publint --strict",
    "test:oxlint": "oxlint src --type-aware",
    "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:lib": "vitest run",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "typescript",
    "tanstack",
    "deepgram",
    "adapter",
    "speech-to-text",
    "transcription",
    "telephony",
    "voice-agent"
  ],
  "dependencies": {
    "@tanstack/ai-utils": "workspace:^"
  },
  "devDependencies": {
    "@tanstack/ai": "workspace:*",
    "@vitest/coverage-v8": "4.1.10",
    "vite": "^8.2.1"
  },
  "peerDependencies": {
    "@tanstack/ai": "workspace:^"
  }
}
