# Copy to .env. Without keys, a demo model answers.
# Each key adds models to /model, and turns on the tools of that provider.
# OpenAI: the gpt models, images, speech, Sora video, and voice input.
OPENAI_API_KEY=
# Anthropic: the claude models.
ANTHROPIC_API_KEY=
# xAI: the grok model, and video with Grok Imagine (it wins over Sora).
XAI_API_KEY=
# fal: songs and sound effects.
FAL_KEY=
# Claude Code and Codex turn on when `claude` and `codex` are on the PATH.
# They use your own `claude login` and `codex login`. Set 0 to turn them off.
CODING_AGENTS=
# Codex uses the model and sandbox_mode of ~/.codex/config.toml. These win.
CODEX_MODEL=
CODEX_SANDBOX_MODE=
# Voice input records the microphone with ffmpeg. The first recording picks
# the microphone; VOICE_DEVICE names one instead. VOICE_LANGUAGE (for example
# en) is the language you talk in.
FFMPEG_PATH=
VOICE_DEVICE=
VOICE_LANGUAGE=
VOICE_MIN_LOUDNESS=
