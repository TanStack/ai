# Optional. The app needs no .env file: run /connect openai (paste a key) or
# /connect openrouter (sign in with the browser) inside the app.
# This file is a shortcut for development. Copy it to .env. An env var works
# when no key is saved with /connect.
# OpenAI: the gpt models, images, speech, Sora video, and voice input.
OPENAI_API_KEY=
# Anthropic: the claude models.
ANTHROPIC_API_KEY=
# xAI: the grok model, video with Grok Imagine (it wins over Sora), and voice.
XAI_API_KEY=
# fal: songs and sound effects.
FAL_KEY=
# OpenRouter: the openrouter-gpt and openrouter-claude models.
OPENROUTER_API_KEY=
# Claude Code and Codex turn on when `claude` and `codex` are on the PATH.
# They use your own `claude login` and `codex login`. Set 0 to turn them off.
CODING_AGENTS=
# Codex uses the model and sandbox_mode of ~/.codex/config.toml. These win.
CODEX_MODEL=
CODEX_SANDBOX_MODE=
# Voice input records the microphone with ffmpeg. The first recording picks
# the microphone. VOICE_DEVICE names one instead. VOICE_LANGUAGE (for example
# en) is the language you talk in.
FFMPEG_PATH=
VOICE_DEVICE=
VOICE_LANGUAGE=
VOICE_MIN_LOUDNESS=
