# Copy to .env. Without keys, a demo model answers.
# The main model: OpenAI first, then Anthropic.
# OPENAI_API_KEY also turns on the image and video tools.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: make videos with Grok Imagine instead of OpenAI Sora.
XAI_API_KEY=
# Optional: hand coding work to Claude Code and Codex (uses claude login and codex login).
CODING_AGENTS=
CODEX_MODEL=
CODEX_SANDBOX_MODE=
