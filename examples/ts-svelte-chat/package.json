{
  "name": "ts-svelte-chat",
  "private": true,
  "version": "0.1.45",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#data/*": "./src/data/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "exit 0",
    "test:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@lucide/svelte": "^1.68.0",
    "@tanstack/ai": "workspace:*",
    "@tanstack/ai-anthropic": "workspace:*",
    "@tanstack/ai-client": "workspace:*",
    "@tanstack/ai-gemini": "workspace:*",
    "@tanstack/ai-ollama": "workspace:*",
    "@tanstack/ai-openai": "workspace:*",
    "@tanstack/ai-svelte": "workspace:*",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.3",
    "marked-highlight": "^2.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.10.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "tslib": "^2.9.1",
    "typescript": "6.0.3",
    "vite": "^8.3.5"
  }
}
