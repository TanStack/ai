# Duplicate this file, rename it to .env, and fill in the key(s) you want to use.
# Only the provider you pick in the UI needs a key.

# TypeSafe. Get a key at https://typesafe.ai
# Used by the `typesafeEvaluator(...)` adapter (@tanstack/ai-typesafe).
TYPESAFE_API_KEY=

# OpenRouter. Get a key at https://openrouter.ai/keys
# Used by the `openRouterEvaluator(...)` adapter (@tanstack/ai-openrouter).
OPENROUTER_API_KEY=

# Vercel AI Gateway.
# Used by the `vercelGatewayEvaluator(...)` adapter (@tanstack/ai-vercel-gateway).
AI_GATEWAY_API_KEY=

# Cloudflare Workers AI REST.
# Used by the `cloudflareEvaluator(...)` adapter (@tanstack/ai-cloudflare).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
