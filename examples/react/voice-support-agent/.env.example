# Server-side keys. Any of these can be left empty and pasted into the page
# instead, where it is sent on the first frame of each call.
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
ELEVENLABS_API_KEY=

# Any secret string. Twilio sends it back as the `token` <Parameter>, so only
# your TwiML can start a phone call on the keys above.
TWILIO_STREAM_TOKEN=
