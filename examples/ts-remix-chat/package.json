    "@tanstack/ai-remix": "workspace:*",
    "remix": "^3.0.0-rc.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "5.9.3"
  }
}
