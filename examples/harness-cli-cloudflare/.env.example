# Optional. The app needs no .env file: run /connect cloudflare inside the
# app. This file is a shortcut for development. Copy it to .env. The env vars
# work when no token is saved with /connect cloudflare.
# A Cloudflare API token with the Workers AI and AI Gateway permissions.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# The AI Gateway that the models go through. Empty means `default`.
CLOUDFLARE_AI_GATEWAY_ID=
# Claude Code and Codex turn on when `claude` and `codex` are on the PATH.
# They use your own `claude login` and `codex login`. Set 0 to turn them off.
CODING_AGENTS=
# Codex uses the model and sandbox_mode of ~/.codex/config.toml. These win.
CODEX_MODEL=
CODEX_SANDBOX_MODE=
# Voice input records the microphone with ffmpeg. The first recording picks
# the microphone. VOICE_DEVICE names one instead. VOICE_LANGUAGE (for example
# en) is the language you talk in.
FFMPEG_PATH=
VOICE_DEVICE=
VOICE_LANGUAGE=
VOICE_MIN_LOUDNESS=
