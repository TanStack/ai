# Duplicate this file, rename it to .env, and fill in the key(s) you want to use.
# Only the provider you pick in the UI needs a key.

# Cohere — https://dashboard.cohere.com/api-keys
# Used by the `cohereRerank(...)` adapter (@tanstack/ai-cohere).
COHERE_API_KEY=

# OpenRouter — https://openrouter.ai/keys
# Used by the `openRouterRerank(...)` adapter (@tanstack/ai-openrouter).
# Routes to Cohere and NVIDIA rerank models through one key.
OPENROUTER_API_KEY=
